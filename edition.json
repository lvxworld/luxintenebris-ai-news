        },
        {
          "title": "Scaling synthetic data environments for RL on data-analysis tasks",
          "summary": "New work generates verifiable data-analysis tasks, files and rubrics from scratch using known generative mechanisms; RL training on these environments yields significant benchmark gains, with frontier models still weaker at interpretation than computation.",
          "source": "@omarsar0",
          "url": "https://x.com/omarsar0/status/2111936617699332566",
          "scout_source": "x"
        },
        {
          "title": "FDE-Gym benchmarks the last mile of AI delivery",
          "summary": "A benchmark of 95 end-to-end forward-deployed-engineer delivery tasks across 20 customer scenarios, scored on real business-metric uplift with scripted stakeholders. The best of 13 model configurations scores 0.56 and resolves only 14/95 tasks; discovering unstated constraints is the main bottleneck.",
          "source": "HuggingFace",
          "url": "https://huggingface.co/papers/2610.22350",
          "scout_source": "research"
        },
        {
          "title": "MJev-Spatial: System One spatial intelligence in a single forward pass",
          "summary": "A System-1 spatial decision model scores candidate answers via native attention matching with no generated tokens. Built on Qwen3.5-4B it tops eight models with 65.64% overall, ranking first on 7 of 12 spatial benchmarks while running 2.5x faster than the fastest autoregressive baseline.",
          "source": "HuggingFace",
          "url": "https://huggingface.co/papers/2610.22276",
          "scout_source": "research"
        },
        {
          "title": "VLA-Delta learns physical state transitions for vision-language-action models",
          "summary": "Supervises VLAs on explicit physical state transitions between current and future states instead of only observation-action mappings. It achieves SOTA-competitive results on LIBERO and RoboTwin and outperforms pi-0.5 in real-robot experiments.",
          "source": "HuggingFace",
          "url": "https://huggingface.co/papers/2610.21306",
          "scout_source": "research"
        }
      ]
